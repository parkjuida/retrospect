---
// 압축본(PQ)으로 후보를 넉넉히 뽑은 뒤 원본으로 다시 거리를 재서 상위 k개를 고르는 재채점 과정을 보여주는 시각화.
// .mdx 노트에서 import 해서 <RescoreViz /> 로 쓴다. 공통 스타일은 src/styles/viz.css.
import VizLegend from './VizLegend.astro';
---

<div class="viz not-content" data-rescore>
	<div class="viz-row">
		<div class="viz-group" role="group" aria-label="검색 방식">
			<button type="button" data-view="plain" aria-pressed="false">압축본만으로 고르기</button>
			<button type="button" data-view="rescore" aria-pressed="true">압축본 + 원본으로 재채점</button>
		</div>
	</div>

	<div class="viz-row">
		<label class="viz-field">
			<span>오버샘플 배수</span>
			<input type="range" data-input="oversample" min="1" max="8" step="1" value="3" />
			<output data-out="oversample">3</output>
		</label>
		<label class="viz-field">
			<span>조각당 비트 수</span>
			<input type="range" data-input="bits" min="1" max="4" step="1" value="2" />
			<output data-out="bits">2</output>
		</label>
	</div>

	<div class="viz-row">
		<div class="viz-group">
			<button type="button" data-act="miss">압축본만으론 틀리는 위치 찾기</button>
			<button type="button" data-act="query">질문 위치 바꾸기</button>
			<button type="button" data-act="new">새 데이터</button>
		</div>
	</div>

	<svg class="viz-canvas" data-map viewBox="0 0 600 360" role="img" aria-label="재채점 지도"></svg>

	<div class="viz-stats">
		<div class="viz-stat"><p class="label">압축본만 recall@5</p><p class="value" data-stat="plain">-</p></div>
		<div class="viz-stat"><p class="label">재채점 후 recall@5</p><p class="value" data-stat="rescore">-</p></div>
		<div class="viz-stat"><p class="label">디스크에서 읽은 원본</p><p class="value" data-stat="reads">-</p></div>
	</div>

	<p class="viz-status" data-status aria-live="polite"></p>

	<VizLegend
		items={[
			{ shape: 'dot', color: 'var(--rs-neutral)', label: '저장된 점' },
			{ shape: 'square-outline', color: 'var(--rs-emphasis)', label: '압축본이 복원되는 위치' },
			{ shape: 'dot', color: 'var(--rs-path)', label: '1단계 후보 (압축본으로 뽑음)' },
			{ shape: 'ring', color: 'var(--rs-result)', label: '최종으로 고른 5개' },
			{ shape: 'dashed-ring', color: 'var(--rs-reference)', label: '진짜 가장 가까운 5개' },
			{ shape: 'cross', color: 'var(--rs-text-strong)', label: '질문 (지도 클릭이나 "질문 위치 바꾸기"로 옮김)' },
		]}
	/>
</div>

<script>
	import { blobPoints, kmeans1d, nearestValue, squaredDistance as sq, toViewBox, type Point } from '../scripts/viz';

	const W = 600;
	const H = 360;
	const PAD = 14;
	const K = 5; // 최종으로 돌려줄 개수

	// 색은 tokens.css의 역할 토큰만 쓴다
	const COLOR = {
		codebook: 'var(--rs-emphasis)',
		candidate: 'var(--rs-path)',
		chosen: 'var(--rs-result)',
		truth: 'var(--rs-reference)',
		query: 'var(--rs-text-strong)',
		point: 'var(--rs-neutral)',
	};

	const f = (v: number) => v.toFixed(1);

	function setup(root: HTMLElement) {
		const svg = root.querySelector<SVGSVGElement>('[data-map]')!;
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const stat = (name: string) => root.querySelector<HTMLElement>(`[data-stat="${name}"]`)!;
		const output = (name: string) => root.querySelector<HTMLOutputElement>(`[data-out="${name}"]`)!;

		let seed = 11;
		let bits = 2;
		let oversample = 3;
		let view: 'plain' | 'rescore' = 'rescore';
		let pts: Point[] = [];
		let codebookX: number[] = [];
		let codebookY: number[] = [];
		let compressed: Point[] = [];
		let query: Point = { x: 300, y: 180 };

		const makeData = () => {
			pts = blobPoints({ seed, width: W, height: H, pad: PAD, blobs: 6, perBlob: [22, 42], spread: [16, 56], noise: 30 });
		};

		/** 조각(x, y)마다 대표값을 학습하고, 각 점을 가장 가까운 대표값 조합으로 바꾼다 */
		function compress() {
			const L = 2 ** bits;
			codebookX = kmeans1d(pts.map((p) => p.x), L);
			codebookY = kmeans1d(pts.map((p) => p.y), L);
			compressed = pts.map((p) => ({ x: nearestValue(p.x, codebookX), y: nearestValue(p.y, codebookY) }));
		}

		function search(q: Point) {
			const ids = pts.map((_, i) => i);
			// 압축 거리: 질문은 원본, 저장된 쪽은 압축본 (비대칭 거리 계산). 동점은 번호 순
			const byCompressed = [...ids].sort((a, b) => sq(q, compressed[a]) - sq(q, compressed[b]) || a - b);
			const byOriginal = (list: number[]) => [...list].sort((a, b) => sq(q, pts[a]) - sq(q, pts[b]));

			const truth = byOriginal(ids).slice(0, K);
			const plain = byCompressed.slice(0, K);
			const candidates = byCompressed.slice(0, Math.min(pts.length, K * oversample));
			const rescored = byOriginal(candidates).slice(0, K);

			const truthSet = new Set(truth);
			const recall = (list: number[]) => list.filter((i) => truthSet.has(i)).length;
			const kthDistance = sq(q, compressed[byCompressed[K - 1]]);
			const ties = byCompressed.filter((i) => sq(q, compressed[i]) === kthDistance).length;
			return { truth, plain, candidates, rescored, recallPlain: recall(plain), recallRescored: recall(rescored), ties };
		}

		function draw() {
			const s = search(query);
			const rescoring = view === 'rescore';
			const candidateSet = new Set(rescoring ? s.candidates : []);
			let o = '';

			for (const x of codebookX) {
				for (const y of codebookY) {
					o += `<rect x="${f(x - 4.5)}" y="${f(y - 4.5)}" width="9" height="9" rx="1.5" fill="none" style="stroke:${COLOR.codebook}" stroke-width="1.4"/>`;
				}
			}
			pts.forEach((p, i) => {
				o += candidateSet.has(i)
					? `<circle cx="${f(p.x)}" cy="${f(p.y)}" r="3.2" style="fill:${COLOR.candidate}"/>`
					: `<circle cx="${f(p.x)}" cy="${f(p.y)}" r="2.3" style="fill:${COLOR.point}"/>`;
			});
			for (const i of rescoring ? s.rescored : s.plain) {
				o += `<circle cx="${f(pts[i].x)}" cy="${f(pts[i].y)}" r="7" fill="none" style="stroke:${COLOR.chosen}" stroke-width="2.2"/>`;
			}
			for (const i of s.truth) {
				o += `<circle cx="${f(pts[i].x)}" cy="${f(pts[i].y)}" r="10.5" fill="none" style="stroke:${COLOR.truth}" stroke-width="1.5" stroke-dasharray="3 2.5"/>`;
			}
			o += `<path d="M${f(query.x - 6)} ${f(query.y - 6)}L${f(query.x + 6)} ${f(query.y + 6)}M${f(query.x - 6)} ${f(query.y + 6)}L${f(query.x + 6)} ${f(query.y - 6)}" style="stroke:${COLOR.query}" stroke-width="2" stroke-linecap="round"/>`;
			svg.innerHTML = o;

			stat('plain').textContent = `${s.recallPlain} / ${K}`;
			stat('rescore').textContent = `${s.recallRescored} / ${K}`;
			stat('reads').textContent = `${rescoring ? s.candidates.length : 0}개`;
			status.textContent = rescoring
				? `압축본 거리로 후보 ${s.candidates.length}개(${K} × ${oversample})를 뽑고, 그것만 원본으로 다시 재서 ${K}개를 골랐어. 진짜 ${K}개 중 ${s.recallRescored}개를 찾았어.` +
					(s.recallRescored < K ? ' 후보에 아예 못 든 정답은 재채점으로도 못 살려. 배수를 올려봐.' : '')
				: `압축본 거리만으로 ${K}개를 골랐어. 진짜 ${K}개 중 ${s.recallPlain}개. ${K}등 자리에서 압축 거리가 똑같은 점이 ${s.ties}개라, 그중 누가 뽑힐지는 사실상 운이야.`;
		}

		function setView(next: 'plain' | 'rescore') {
			view = next;
			root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === next)));
			draw();
		}

		const randomQuery = (): Point => ({ x: PAD + Math.random() * (W - 2 * PAD), y: PAD + Math.random() * (H - 2 * PAD) });

		root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.view as 'plain' | 'rescore')));
		root.querySelector<HTMLInputElement>('[data-input="oversample"]')!.addEventListener('input', (e) => {
			oversample = Number((e.target as HTMLInputElement).value);
			output('oversample').textContent = String(oversample);
			draw();
		});
		root.querySelector<HTMLInputElement>('[data-input="bits"]')!.addEventListener('input', (e) => {
			bits = Number((e.target as HTMLInputElement).value);
			output('bits').textContent = String(bits);
			compress();
			draw();
		});

		const actions: Record<string, () => void> = {
			new: () => {
				seed += 1;
				makeData();
				compress();
				draw();
			},
			query: () => {
				query = randomQuery();
				draw();
			},
			miss: () => {
				for (let t = 0; t < 1500; t++) {
					const q = randomQuery();
					if (search(q).recallPlain <= K - 2) {
						query = q;
						setView('plain');
						return;
					}
				}
				draw();
				status.textContent = '지금 압축 정도에서는 틀리는 위치를 못 찾았어. 조각당 비트 수를 줄여봐.';
			},
		};
		root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) => b.addEventListener('click', actions[b.dataset.act!]));

		svg.addEventListener('click', (e) => {
			query = toViewBox(svg, e);
			draw();
		});

		makeData();
		compress();
		draw();
	}

	document.querySelectorAll<HTMLElement>('[data-rescore]').forEach(setup);
</script>
