---
// HNSW 그래프를 만드는 과정(점 삽입)과 검색 과정을 층별로 단계씩 보여주는 시각화.
// .mdx 노트에서 import 해서 <HnswViz /> 로 쓴다.
---

<div class="hnsw not-content" data-hnsw>
	<div class="row">
		<div class="group" role="group" aria-label="보기 선택">
			<button type="button" data-mode="build" aria-pressed="true">그래프 만들기</button>
			<button type="button" data-mode="search" aria-pressed="false">검색하기</button>
		</div>
		<div class="group" role="group" aria-label="단계 이동">
			<button type="button" data-act="prev">이전</button>
			<button type="button" data-act="next">다음</button>
			<button type="button" data-act="play" aria-pressed="false">자동 재생</button>
			<button type="button" data-act="reset">처음부터</button>
		</div>
	</div>

	<div class="row">
		<label class="field">
			<span>M (이웃 수)</span>
			<input type="range" data-input="m" min="2" max="5" step="1" value="3" />
			<output data-out="m">3</output>
		</label>
		<label class="field">
			<span>ef_search (후보 목록 크기)</span>
			<input type="range" data-input="ef" min="1" max="12" step="1" value="2" />
			<output data-out="ef">2</output>
		</label>
		<label class="field">
			<span>이웃 선택 방식</span>
			<select data-input="heuristic">
				<option value="h">휴리스틱</option>
				<option value="s">가장 가까운 M개</option>
			</select>
		</label>
	</div>

	<div class="row">
		<div class="group">
			<button type="button" data-act="query">질문 위치 바꾸기</button>
			<button type="button" data-act="new">새 데이터</button>
		</div>
	</div>

	<div class="panels">
		<figure>
			<figcaption>2층 · 고속도로</figcaption>
			<svg data-layer="2" viewBox="0 0 200 200" role="img" aria-label="2층 그래프"></svg>
		</figure>
		<figure>
			<figcaption>1층 · 국도</figcaption>
			<svg data-layer="1" viewBox="0 0 200 200" role="img" aria-label="1층 그래프"></svg>
		</figure>
		<figure>
			<figcaption>0층 · 모든 점</figcaption>
			<svg data-layer="0" viewBox="0 0 200 200" role="img" aria-label="0층 그래프"></svg>
		</figure>
	</div>

	<p class="status" data-status aria-live="polite"></p>

	<ul class="legend">
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.8" style="fill: var(--rs-neutral)"></circle></svg>
			이 층의 점
		</li>
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="1.8" style="fill: var(--rs-border)"></circle></svg>
			이 층에 없거나 아직 안 넣은 점
		</li>
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><line x1="1" y1="8" x2="15" y2="8" style="stroke: var(--rs-border)" stroke-width="1.2" stroke-linecap="round"></line></svg>
			기존 연결
		</li>
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="4.5" style="fill: var(--rs-emphasis)"></circle></svg>
			새로 넣는 점 · 지금 위치
		</li>
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><line x1="1" y1="8" x2="15" y2="8" style="stroke: var(--rs-emphasis)" stroke-width="2.2" stroke-linecap="round"></line></svg>
			새로 만든 연결
		</li>
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><line x1="1" y1="12" x2="11" y2="5" style="stroke: var(--rs-path)" stroke-width="1.5" stroke-linecap="round"></line><circle cx="11" cy="5" r="3.5" style="fill: var(--rs-path)"></circle></svg>
			거리를 계산한 점과 경로
		</li>
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" fill="none" style="stroke: var(--rs-result)" stroke-width="2"></circle></svg>
			찾은 후보 (ef개, 굵은 원이 1등)
		</li>
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="none" style="stroke: var(--rs-reference)" stroke-width="1.6" stroke-dasharray="2.5 2"></circle></svg>
			진짜 1등
		</li>
		<li>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4L12 12M4 12L12 4" style="stroke: var(--rs-text-strong)" stroke-width="1.8" stroke-linecap="round"></path></svg>
			질문 (패널 클릭이나 "질문 위치 바꾸기"로 옮김)
		</li>
	</ul>
</div>

<style>
	.hnsw {
		margin-block: 1.5rem;
		font-size: var(--sl-text-sm);
		color: var(--rs-text);
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin-bottom: 0.75rem;
	}

	.group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	button,
	select {
		min-height: 2rem;
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--rs-border);
		border-radius: var(--rs-radius);
		background: var(--rs-surface);
		color: var(--rs-text);
		font: inherit;
		cursor: pointer;
	}

	button:hover,
	select:hover {
		background: var(--rs-surface-hover);
	}

	button[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}

	button:focus-visible,
	select:focus-visible,
	input:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.field {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--rs-text-muted);
	}

	.field input[type='range'] {
		width: 6rem;
		accent-color: var(--sl-color-accent);
	}

	output {
		min-width: 1.25rem;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
		color: var(--rs-text);
	}

	.panels {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 0.75rem;
	}

	figure {
		margin: 0;
	}

	figcaption {
		margin-bottom: 0.25rem;
		color: var(--rs-text-muted);
	}

	.panels svg {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--rs-border);
		border-radius: var(--rs-radius);
		background: var(--rs-surface);
		cursor: crosshair;
	}

	.status {
		min-height: 1.6em;
		margin: 0.75rem 0 0;
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-xs);
		color: var(--rs-text-muted);
	}

	.legend li {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	.legend svg {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
	}
</style>

<script>
	type Point = { x: number; y: number };
	type Event = { t: 'visit' | 'expand' | 'down'; L: number; n: number; from?: number | null };
	type Adjacency = Record<number, number[]>[];
	type Insertion = { i: number; level: number; ev: Event[]; added: { L: number; a: number; b: number }[]; adj: Adjacency };

	const N = 50; // 점 개수
	const EF_CONSTRUCTION = 8;
	const MAX_LEVEL = 2; // 패널이 세 개라서 2층까지만
	const PAD = 10;
	const VIEW = 200;

	// 색은 tokens.css의 역할 토큰만 쓴다
	const COLOR = {
		current: 'var(--rs-emphasis)',
		path: 'var(--rs-path)',
		found: 'var(--rs-result)',
		truth: 'var(--rs-reference)',
		query: 'var(--rs-text-strong)',
		node: 'var(--rs-neutral)',
		ghost: 'var(--rs-border)',
		label: 'var(--rs-text-muted)',
	};

	/** 같은 seed면 같은 난수열 (mulberry32) */
	function rng(seed: number) {
		let a = seed;
		return () => {
			a |= 0;
			a = (a + 0x6d2b79f5) | 0;
			let t = Math.imul(a ^ (a >>> 15), 1 | a);
			t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
			return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
		};
	}

	const dist = (a: Point, b: Point) => Math.hypot(a.x - b.x, a.y - b.y);
	const toView = (v: number) => (PAD + v * (VIEW - 2 * PAD)).toFixed(1);

	function setup(root: HTMLElement) {
		const panels = [0, 1, 2].map((L) => root.querySelector<SVGSVGElement>(`svg[data-layer="${L}"]`)!);
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const playButton = root.querySelector<HTMLButtonElement>('[data-act="play"]')!;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let seed = 7;
		let M = 3;
		let heuristic = true;
		let efSearch = 2;
		let pts: Point[] = [];
		let levels: number[] = [];
		let build: { steps: Insertion[]; adj: Adjacency; entry: number; top: number };
		let trace: { ev: Event[]; W: number[]; truth: number; steps: number[] };
		let query: Point = { x: 0.78, y: 0.22 };
		let mode: 'build' | 'search' = 'build';
		let step = 0;
		let timer: number | undefined;

		function makeData() {
			const r = rng(seed);
			pts = Array.from({ length: N }, () => ({ x: 0.04 + 0.92 * r(), y: 0.04 + 0.92 * r() }));
			// L층 이상에 올라갈 확률 = 1 / M^L
			const r2 = rng(seed * 31 + 1);
			levels = pts.map(() => Math.min(MAX_LEVEL, Math.floor(-Math.log(1 - r2()) / Math.log(M))));
		}

		/** 한 층 안에서 q에 가까운 점을 ef개까지 찾는다 (HNSW 논문의 SEARCH-LAYER) */
		function searchLayer(q: Point, eps: number[], ef: number, L: number, adj: Adjacency, ev: Event[]) {
			const dq = (i: number) => dist(q, pts[i]);
			const byDist = (a: number, b: number) => dq(a) - dq(b);
			const visited = new Set(eps);
			const candidates = eps.slice();
			const found = eps.slice();
			eps.forEach((n) => ev.push({ t: 'visit', L, n, from: null }));

			while (candidates.length) {
				candidates.sort(byDist);
				const c = candidates.shift()!;
				found.sort(byDist);
				// 남은 후보 중 가장 가까운 것도 목록의 꼴찌보다 멀면 멈춘다
				if (dq(c) > dq(found[found.length - 1])) break;
				ev.push({ t: 'expand', L, n: c });
				for (const e of adj[L][c] ?? []) {
					if (visited.has(e)) continue;
					visited.add(e);
					ev.push({ t: 'visit', L, n: e, from: c });
					found.sort(byDist);
					if (found.length < ef || dq(e) < dq(found[found.length - 1])) {
						candidates.push(e);
						found.push(e);
						found.sort(byDist);
						if (found.length > ef) found.pop();
					}
				}
			}
			return found.sort(byDist);
		}

		/** 후보 중 이웃 m개를 고른다. 휴리스틱: 이미 고른 이웃보다 q에 더 가까운 후보만 */
		function selectNeighbors(q: Point, cands: number[], m: number) {
			const sorted = [...new Set(cands)].sort((a, b) => dist(q, pts[a]) - dist(q, pts[b]));
			if (!heuristic) return sorted.slice(0, m);
			const picked: number[] = [];
			for (const e of sorted) {
				if (picked.length >= m) break;
				if (picked.every((r) => dist(pts[e], q) < dist(pts[e], pts[r]))) picked.push(e);
			}
			return picked;
		}

		function buildGraph() {
			const adj: Adjacency = [{}, {}, {}];
			let entry = -1;
			let top = -1;
			const steps: Insertion[] = [];

			for (let i = 0; i < N; i++) {
				const level = levels[i];
				const q = pts[i];
				const ev: Event[] = [];
				const added: Insertion['added'] = [];
				for (let L = 0; L <= level; L++) adj[L][i] = [];

				if (entry < 0) {
					entry = i;
					top = level;
				} else {
					let ep = [entry];
					// 이 점이 올라가지 않는 층: 가장 가까운 점 하나만 쫓아 내려간다
					for (let L = top; L > level; L--) ep = [searchLayer(q, ep, 1, L, adj, ev)[0]];
					// 이 점이 속한 층: 후보를 넓게 모아 이웃을 고르고 양방향으로 잇는다
					for (let L = Math.min(top, level); L >= 0; L--) {
						const W = searchLayer(q, ep, EF_CONSTRUCTION, L, adj, ev);
						const maxLinks = L === 0 ? 2 * M : M;
						for (const e of selectNeighbors(q, W, M)) {
							adj[L][i].push(e);
							adj[L][e].push(i);
							added.push({ L, a: i, b: e });
							if (adj[L][e].length > maxLinks) adj[L][e] = selectNeighbors(pts[e], adj[L][e], maxLinks);
						}
						ep = W;
					}
					if (level > top) {
						entry = i;
						top = level;
					}
				}

				const snapshot = adj.map((layer) => Object.fromEntries(Object.entries(layer).map(([k, v]) => [k, v.slice()])));
				steps.push({ i, level, ev, added, adj: snapshot });
			}
			return { steps, adj, entry, top };
		}

		function searchGraph() {
			const { adj, entry, top } = build;
			const ev: Event[] = [];
			let ep = [entry];
			for (let L = top; L > 0; L--) {
				ep = [searchLayer(query, ep, 1, L, adj, ev)[0]];
				ev.push({ t: 'down', L, n: ep[0] });
			}
			const W = searchLayer(query, ep, efSearch, 0, adj, ev);
			const truth = pts.map((_, i) => i).sort((a, b) => dist(query, pts[a]) - dist(query, pts[b]))[0];
			const steps = ev.flatMap((e, k) => (e.t === 'expand' || e.t === 'down' ? [k] : []));
			return { ev, W, truth, steps };
		}

		const lastStep = () => (mode === 'build' ? N : trace.steps.length);

		const line = (a: number, b: number, color: string, width: number) =>
			`<line x1="${toView(pts[a].x)}" y1="${toView(pts[a].y)}" x2="${toView(pts[b].x)}" y2="${toView(pts[b].y)}" style="stroke:${color}" stroke-width="${width}" stroke-linecap="round"/>`;
		const dot = (i: number, r: number, color: string) =>
			`<circle cx="${toView(pts[i].x)}" cy="${toView(pts[i].y)}" r="${r}" style="fill:${color}"/>`;
		const ring = (i: number, r: number, color: string, width: number, dashed = false) =>
			`<circle cx="${toView(pts[i].x)}" cy="${toView(pts[i].y)}" r="${r}" fill="none" style="stroke:${color}" stroke-width="${width}"${dashed ? ' stroke-dasharray="2.5 2"' : ''}/>`;

		function draw() {
			const isBuild = mode === 'build';
			const inserted = isBuild ? step : N;
			const snap = isBuild && step > 0 ? build.steps[step - 1] : null;
			const adj = isBuild ? (snap?.adj ?? [{}, {}, {}]) : build.adj;

			let evs: Event[] = snap?.ev ?? [];
			const added = snap?.added ?? [];
			let current: Event | null = null;
			let finished = false;
			if (!isBuild) {
				if (step >= trace.steps.length) {
					evs = trace.ev;
					finished = true;
				} else {
					const cut = trace.steps[step];
					evs = trace.ev.slice(0, cut + 1);
					current = trace.ev[cut];
				}
			}

			panels.forEach((svg, L) => {
				let s = '';
				// 이 층에 없는 점은 흐리게
				for (let i = 0; i < N; i++) if (!(i < inserted && levels[i] >= L)) s += dot(i, 1.5, COLOR.ghost);

				const drawn = new Set<string>();
				for (const [k, neighbors] of Object.entries(adj[L])) {
					for (const b of neighbors) {
						const a = Number(k);
						const key = a < b ? `${a}-${b}` : `${b}-${a}`;
						if (drawn.has(key)) continue;
						drawn.add(key);
						s += line(a, b, COLOR.ghost, 0.8);
					}
				}

				const visited = new Set<number>();
				for (const e of evs) {
					if (e.L !== L || e.t !== 'visit') continue;
					visited.add(e.n);
					if (e.from != null) s += line(e.from, e.n, COLOR.path, 1.5);
				}
				for (const a of added) if (a.L === L) s += line(a.a, a.b, COLOR.current, 2.2);

				for (let i = 0; i < inserted; i++) {
					if (levels[i] < L) continue;
					s += visited.has(i) ? dot(i, 3.8, COLOR.path) : dot(i, 2.8, COLOR.node);
				}
				if (snap && levels[snap.i] >= L) s += dot(snap.i, 5.5, COLOR.current);
				if (current && current.L === L) s += dot(current.n, 5.5, COLOR.current);

				if (finished && L === 0) {
					trace.W.forEach((w, k) => (s += ring(w, k === 0 ? 7.5 : 6, COLOR.found, k === 0 ? 2.2 : 1.2)));
					s += ring(trace.truth, 10.5, COLOR.truth, 1.6, true);
				}
				if (!isBuild) {
					const qx = Number(toView(query.x));
					const qy = Number(toView(query.y));
					s += `<path d="M${qx - 5} ${qy - 5}L${qx + 5} ${qy + 5}M${qx - 5} ${qy + 5}L${qx + 5} ${qy - 5}" style="stroke:${COLOR.query}" stroke-width="1.8" stroke-linecap="round"/>`;
				}
				const layerIsEmpty = !levels.some((level, i) => i < inserted && level >= L);
				if (layerIsEmpty) {
					const message = inserted === 0 ? '아직 넣은 점이 없음' : `${L}층까지 올라간 점이 없음`;
					s += `<text x="${VIEW / 2}" y="${VIEW / 2}" text-anchor="middle" dominant-baseline="middle" font-size="11" style="fill:${COLOR.label}">${message}</text>`;
				}
				svg.innerHTML = s;
			});

			status.textContent = describe(snap, evs, current, finished);
		}

		function describe(snap: Insertion | null, evs: Event[], current: Event | null, finished: boolean) {
			const count = (list: Event[]) => new Set(list.filter((e) => e.t === 'visit').map((e) => e.n)).size;
			if (mode === 'build') {
				if (!snap) return '아직 점이 없어. 다음을 누르면 점을 하나씩 넣어.';
				return `${step}번째 점 삽입 · 이 점은 ${snap.level}층까지 올라감 · 새 연결 ${snap.added.length}개 · 거리 계산 ${count(snap.ev)}번 (이미 넣은 점 ${step - 1}개 중)`;
			}
			const n = count(evs);
			if (finished) {
				const hit = trace.W[0] === trace.truth;
				return `찾은 1등이 진짜 1등과 ${hit ? '같아' : '달라 (놓침)'} · 거리 계산 ${n}번 / 전체 ${N}개`;
			}
			if (current?.t === 'down') return `${current.L}층에서 더 가까운 이웃이 없음 → 이 점을 들고 ${current.L - 1}층으로 내려감 · 거리 계산 ${n}번`;
			return `${current?.L}층 · 지금 위치의 이웃들과 거리 비교 · 거리 계산 ${n}번`;
		}

		function stop() {
			if (timer !== undefined) window.clearInterval(timer);
			timer = undefined;
			playButton.setAttribute('aria-pressed', 'false');
		}

		function play() {
			if (reducedMotion) {
				// 움직임 줄이기 설정: 애니메이션 대신 마지막 단계를 보여주고 이유를 알린다
				step = lastStep();
				draw();
				status.textContent += ' · 움직임 줄이기 설정이 켜져 있어서 자동 재생 대신 마지막 단계를 보여줘. 이전/다음으로 한 단계씩 볼 수 있어.';
				return;
			}
			if (step >= lastStep()) step = 0;
			playButton.setAttribute('aria-pressed', 'true');
			draw();
			timer = window.setInterval(
				() => {
					if (step >= lastStep()) return stop();
					step++;
					draw();
				},
				mode === 'build' ? 420 : 520,
			);
		}

		function rebuild() {
			makeData();
			build = buildGraph();
			trace = searchGraph();
		}

		function setMode(next: 'build' | 'search') {
			stop();
			mode = next;
			root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === next)));
			if (next === 'build') {
				step = N;
				draw();
			} else {
				step = 0;
				play();
			}
		}

		root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as 'build' | 'search')));

		const actions: Record<string, () => void> = {
			prev: () => (stop(), (step = Math.max(0, step - 1)), draw()),
			next: () => (stop(), (step = Math.min(lastStep(), step + 1)), draw()),
			reset: () => (stop(), (step = 0), draw()),
			play: () => (timer !== undefined ? stop() : play()),
			new: () => (stop(), (seed += 1), rebuild(), (step = lastStep()), draw()),
			query: () => moveQuery({ x: 0.05 + 0.9 * Math.random(), y: 0.05 + 0.9 * Math.random() }),
		};
		root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) => b.addEventListener('click', actions[b.dataset.act!]));

		const input = (name: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-input="${name}"]`)!;
		const output = (name: string) => root.querySelector<HTMLOutputElement>(`[data-out="${name}"]`)!;

		input('m').addEventListener('input', (e) => {
			M = Number((e.target as HTMLInputElement).value);
			output('m').textContent = String(M);
			stop();
			rebuild();
			step = lastStep();
			draw();
		});
		input('ef').addEventListener('input', (e) => {
			efSearch = Number((e.target as HTMLInputElement).value);
			output('ef').textContent = String(efSearch);
			stop();
			trace = searchGraph();
			if (mode === 'search') step = lastStep();
			draw();
		});
		input('heuristic').addEventListener('change', (e) => {
			heuristic = (e.target as HTMLSelectElement).value === 'h';
			stop();
			rebuild();
			step = lastStep();
			draw();
		});

		function moveQuery(next: Point) {
			query = next;
			trace = searchGraph();
			if (mode === 'search') {
				stop();
				step = 0;
				play();
			} else {
				setMode('search');
			}
		}

		panels.forEach((svg) =>
			svg.addEventListener('click', (e) => {
				const rect = svg.getBoundingClientRect();
				const toData = (v: number) => Math.min(1, Math.max(0, (v - PAD) / (VIEW - 2 * PAD)));
				moveQuery({
					x: toData(((e.clientX - rect.left) / rect.width) * VIEW),
					y: toData(((e.clientY - rect.top) / rect.height) * VIEW),
				});
			}),
		);

		rebuild();
		step = N;
		draw();
	}

	document.querySelectorAll<HTMLElement>('[data-hnsw]').forEach(setup);
</script>
