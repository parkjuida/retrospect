---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notes = await getCollection('docs');

const byTag = new Map<string, typeof notes>();
for (const note of notes) {
	for (const tag of note.data.tags) {
		byTag.set(tag, [...(byTag.get(tag) ?? []), note]);
	}
}
const tags = [...byTag.keys()].sort((a, b) => a.localeCompare(b, 'ko'));
---

<StarlightPage
	frontmatter={{ title: '태그로 보기', description: '태그별 노트 모음' }}
	headings={tags.map((tag) => ({ depth: 2, slug: tag, text: `#${tag}` }))}
>
	{tags.length === 0 && <p>아직 태그가 달린 노트가 없어.</p>}
	{
		tags.map((tag) => (
			<>
				<h2 id={tag}>#{tag}</h2>
				<ul>
					{byTag.get(tag)!.map((n) => (
						<li>
							<a href={`${base}/${n.id}/`}>{n.data.title}</a>
						</li>
					))}
				</ul>
			</>
		))
	}
</StarlightPage>
